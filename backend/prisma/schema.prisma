generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  HELPER
  OPS
  ADMIN
}

enum OrderStatus {
  PENDING_REVIEW
  PLAN_SENT
  APPROVED
  ASSIGNED
  OTP_VERIFIED
  IN_PROGRESS
  COMPLETED
  PAID
  CANCELLED
  REWORK
}

model User {
  id           String         @id @default(uuid())
  phone        String         @unique
  name         String?
  role         Role           @default(CUSTOMER)
  otpHash      String?
  otpExpiresAt DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  addresses    Address[]
  cart         Cart?
  orders       Order[]
  planRequests PlanRequest[]
  helper       HelperProfile?
  reviews      Review[]
  tickets      SupportTicket[]
  auditLogs    AuditLog[]
}

model Address {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  society          String
  tower            String
  sector           String
  flat             String
  lat              Float
  lng              Float
  gateInstructions String?
  isDefault        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  orders           Order[]
}

model Service {
  id          String     @id @default(uuid())
  slug        String     @unique
  name        String
  category    String
  price       Int
  mrp         Int?
  duration    String
  rating      Float      @default(4.8)
  reviewCount Int        @default(0)
  description String
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  packItems   PackItem[]
}

model GroceryItem {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  aisle       String
  price       Int
  mrp         Int?
  unit        String
  rating      Float    @default(4.8)
  reviewCount Int      @default(0)
  description String
  inStock     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Pack {
  id            String     @id @default(uuid())
  slug          String     @unique
  name          String
  description   String
  originalPrice Int
  packPrice     Int
  duration      String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  items         PackItem[]
}

model PackItem {
  id        String  @id @default(uuid())
  packId    String
  pack      Pack    @relation(fields: [packId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])
}

model Coupon {
  id            String   @id @default(uuid())
  code          String   @unique
  discountType  String
  discountValue Int
  firstOrderOnly Boolean @default(false)
  weekendOnly   Boolean  @default(false)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime   @updatedAt
  items     CartItem[]
}

model CartItem {
  id        String @id @default(uuid())
  cartId    String
  cart      Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)
  itemType  String
  itemId    String
  name      String
  price     Int
  qty       Int    @default(1)
}

model Order {
  id           String               @id @default(uuid())
  userId       String
  user         User                 @relation(fields: [userId], references: [id])
  addressId    String?
  address      Address?             @relation(fields: [addressId], references: [id])
  status       OrderStatus          @default(PENDING_REVIEW)
  slot         String
  doorOtp      String
  subtotal     Int
  discount     Int                  @default(0)
  platformFee  Int
  total        Int
  couponCode   String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  items        OrderItem[]
  history      OrderStatusHistory[]
  assignments  Assignment[]
  payments     Payment[]
  reviews      Review[]
}

model OrderItem {
  id       String @id @default(uuid())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemType String
  itemId   String
  name     String
  price    Int
  qty      Int
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
}

model PlanRequest {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  rawText   String
  status    String   @default("PENDING_REVIEW")
  createdAt DateTime @default(now())
  plans     Plan[]
}

model Plan {
  id          String         @id @default(uuid())
  requestId   String
  request     PlanRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  platformFee Int
  total       Int
  status      String         @default("SENT")
  createdAt   DateTime       @default(now())
  items       PlanLineItem[]
}

model PlanLineItem {
  id     String @id @default(uuid())
  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  name   String
  price  Int
  qty    Int    @default(1)
}

model HelperProfile {
  id          String       @id @default(uuid())
  userId      String       @unique
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sector      String
  skills      String[]
  verified    Boolean      @default(false)
  online      Boolean      @default(false)
  rating      Float        @default(4.9)
  lat         Float?
  lng         Float?
  docUrl      String?
  assignments Assignment[]
}

model Assignment {
  id        String        @id @default(uuid())
  orderId   String
  order     Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  helperId  String
  helper    HelperProfile @relation(fields: [helperId], references: [id])
  status    String        @default("ASSIGNED")
  createdAt DateTime      @default(now())
}

model Payment {
  id               String   @id @default(uuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider         String   @default("razorpay")
  providerOrderId  String?
  providerPayId    String?
  method           String
  amount           Int
  status           String   @default("CREATED")
  idempotencyKey   String   @unique
  createdAt        DateTime @default(now())
}

model Review {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model ServiceArea {
  id      String  @id @default(uuid())
  name    String
  sector  String  @unique
  minLat  Float
  maxLat  Float
  minLng  Float
  maxLng  Float
  active  Boolean @default(true)
}

model SupportTicket {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  subject   String
  message   String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String
  meta      Json?
  createdAt DateTime @default(now())
}
