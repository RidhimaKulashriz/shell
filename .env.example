# Required
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
APP_SECRET=change-me-to-a-long-random-string
APP_VERSION=0.1.0
# Use `none` for HTTPS embedded previews; keep `lax` for local HTTP development.
SESSION_COOKIE_SAMESITE=lax

# Public site
NEXT_PUBLIC_SITE_URL=https://your-domain.example
# Vercel only: public URL of the Render API service, without a trailing slash.
BACKEND_URL=https://your-shell-api.onrender.com
NEXT_PUBLIC_WHATSAPP_NUMBER=919999900000
SHOW_DEMO_DATA=true            # set false to hide seeded demo waitlist rows from public counters

# OTP (default: mock, accepts 123456). For live: OTP_PROVIDER=msg91
OTP_PROVIDER=mock
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Payments (default: mock). Set both for live Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Providers behind interfaces (mock when empty)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
KYC_PROVIDER=mock               # digio | idfy | signzy
TELEPHONY_PROVIDER=mock         # masked calling
STT_PROVIDER=browser            # speech-to-text for Hindi/Hinglish
PLAN_LLM_PROVIDER=keyword       # plan drafting model
MAP_PROVIDER=svg                # svg | maplibre
NEXT_PUBLIC_POSTHOG_KEY=
SENTRY_DSN=
