# Required
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Recommended in production
APP_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_SITE_URL=https://your-domain.example
NEXT_PUBLIC_WHATSAPP_NUMBER=919810000000

# Optional providers. Every one has a working mock when unset.
MSG91_AUTH_KEY=            # phone OTP (WhatsApp first, SMS fallback). Unset = demo OTP 123456
TWILIO_AUTH_TOKEN=         # alternative OTP provider
RAZORPAY_KEY_ID=           # payments. Unset = mock checkout
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=   # verifies /api/webhooks/razorpay signatures
WHATSAPP_TOKEN=            # WhatsApp Business Cloud API for notifications
KYC_PROVIDER_KEY=          # Digio / IDfy / Signzy. Only a reference + verified flag is stored
TELEPHONY_KEY=             # masked calling provider
MAPTILER_KEY=              # optional MapLibre tiles (the built-in map is SVG and needs no key)
GOOGLE_MAPS_KEY=           # optional geocoding and routes
NEXT_PUBLIC_POSTHOG_KEY=   # analytics, loaded only after cookie consent
SENTRY_DSN=
